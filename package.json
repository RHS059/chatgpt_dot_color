{
  "name": "chatgpt-dot-color",
  "version": "1.0.0",
  "private": true,
  "description": "Firefox extension for accessible ChatGPT outgoing bubble colors",
  "scripts": {
    "test": "node --test",
    "lint": "node scripts/check-syntax.js && web-ext lint --source-dir extension --warnings-as-errors",
    "build": "web-ext build --source-dir extension --artifacts-dir dist --overwrite-dest",
    "check": "npm run lint && npm test && npm run build"
  },
  "engines": { "node": ">=24" },
  "devDependencies": { "jsdom": "30.1.1", "web-ext": "10.7.0" }
}
